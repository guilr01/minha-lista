# Copie para .env.local e preencha com os dados do projeto Supabase
# (Project Settings > API). Nunca versione o .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só no servidor: confirmar pagamento (webhook). Nunca com prefixo NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Testes de banco: um Postgres comum, sem Supabase (ver README).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Copie para .env.local. Nunca versione o .env.local.

# Neon: a string de conexão POOLED (painel do Neon > Connect, "Connection pooling").
# A aplicação conecta como o dono do banco e troca de papel a cada requisição.
DATABASE_URL=postgres://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require

# Pagamento. "fake" até o gateway de verdade entrar.
PAGAMENTO_PROVEDOR=fake
# Com o falso em produção, o botão "Simular pagamento aprovado" só aparece com
# esta liberação: ele marca pedido como pago sem dinheiro nenhum.
# PAGAMENTO_FAKE_LIBERADO=1

# Testes: um Postgres comum com um usuário administrador (ver README).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
